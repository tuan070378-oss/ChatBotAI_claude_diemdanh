rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // KnowledgeItem Validation
    function isValidKnowledgeItem(data) {
      return data.keys().hasAll(['subjectId', 'content', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.subjectId is string && data.subjectId.size() <= 50 &&
             data.content is string && data.content.size() <= 10000 &&
             data.createdAt is timestamp;
    }

    // QuestionBankItem Validation
    function isValidQuestionBankItem(data) {
      return data.subjectId is string && data.subjectId.size() > 0
        && data.question is string && data.question.size() > 0
        && data.options is list && data.options.size() == 4
        && data.correctAnswer is string && data.correctAnswer.size() > 0
        && data.questionId is string;
    }

    match /knowledge/{itemId} {
      allow read: if true; // Publicly readable for all students to use in RAG
      
      // Since the app uses a custom page-level password check (Tuan1978 / 1210) rather than Firebase Auth,
      // we permit unauthenticated read, create, update, and delete, while maintaining structural schema checks.
      allow create: if isValidKnowledgeItem(incoming());
      allow update: if isValidKnowledgeItem(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['content', 'subjectId', 'chapter', 'embedding'])
      );
      allow delete: if true;
    }

    match /question_bank/{questionId} {
      allow read: if true;
      allow create: if isValidQuestionBankItem(incoming());
      allow update: if false;
      allow delete: if false;
    }
  }
}
